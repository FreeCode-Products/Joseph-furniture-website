# ==========================================
# SEO Configuration
# ==========================================

# Your domain/site URL (used in all SEO tags)
NEXT_PUBLIC_SITE_URL=https://elshaddaifurnitures.com

# Google Search Console verification code (optional but recommended)
# Get this from: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ==========================================
# Business Information
# ==========================================
# Used in Local Business schema and contact info

NEXT_PUBLIC_BUSINESS_PHONE=+91-XXXXXXXXXX
NEXT_PUBLIC_BUSINESS_EMAIL=contact@elshaddaifurnitures.com
NEXT_PUBLIC_BUSINESS_CITY=Your City Name
NEXT_PUBLIC_BUSINESS_STATE=Your State/Province
NEXT_PUBLIC_BUSINESS_ZIP=XXXXX
NEXT_PUBLIC_BUSINESS_ADDRESS=Your Full Business Address

# ==========================================
# Optional: Social Media & Analytics
# ==========================================

# Google Analytics 4 (GA4) Measurement ID
NEXT_PUBLIC_GA4_ID=

# Social Media Handles (for schema markup)
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/elshaddaifurnitures
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/elshaddaifurnitures
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/elshaddaifurnitures

# WhatsApp Contact (for contact buttons)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ==========================================
# Instructions
# ==========================================
#
# 1. Copy this file to .env.local
# 2. Fill in all required fields (marked with NEXT_PUBLIC_)
# 3. These variables will be available in browser and build time
#
# For development:
#   cp .env.example .env.local
#   Update values in .env.local
#
# Variables starting with NEXT_PUBLIC_ are exposed to the browser
# DO NOT put secrets/API keys here
#
# ==========================================
